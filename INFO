mi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    NoSQL (key-value)\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Time Series\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Graph\\\\\n    \\textbf{C) C (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q11:} What is the key benefit of a graph database?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    Fast read performance\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    Flexible schema\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Efficient relationship storage\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    High scalability\\\\\n    \\textbf{C) C (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q12:} Which process is used to transform data before loading\ninto a data warehouse?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    ELT\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    ETL\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Both A and B\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Neither\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerat
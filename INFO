umi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Security\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q8:} Which NoSQL database stores data in JSON-like documents?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    Cassandra\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    MongoDB\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Neo4j\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Redis\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q9:} What is the purpose of a database schema?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    To store data in memory\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    To define data structure\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    To handle real-time transactions\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    To optimize queries\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q10:} Which database type is best for IoT applications?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    Relational\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    NoSQL (key-value)\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Time Series\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Graph\\\\\n    \\textbf{C) C (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q11:} What is the key benefit of a graph database?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    Fast read performance\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    Flexible schema\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Efficient relationship storage\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    High scalability\\\\\n    \\textbf{C) C (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q12:} Which process is used to transform data before loading\ninto a data warehouse?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    ELT\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    ETL\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Both A and B\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Neither\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q13:} What is the main limitation of traditional relational\ndatabases?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    High cost\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    Poor scalability\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Complexity\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Security risks\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q14:} Which database type is optimized for high\nwrite-throughput?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    Relational\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    NoSQL (columnar)\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Graph\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    Time Series\\\\\n    \\textbf{C) B (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\textbf{Q15:} What is the primary use case for a data lake?\n\n\\begin{itemize}\n\\tightlist\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\tightlist\n  \\item\n    Real-time analytics\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{1}\n  \\tightlist\n  \\item\n    Structured data storage\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{2}\n  \\tightlist\n  \\item\n    Unstructured data storage\\\\\n  \\end{enumerate}\n\\item\n  \\begin{enumerate}\n  \\def\\labelenumi{\\Alph{enumi})}\n  \\setcounter{enumi}{3}\n  \\tightlist\n  \\item\n    OLTP transactions\\\\\n    \\textbf{C) C (Correct)}\n  \\end{enumerate}\n\\end{itemize}\n\n\\begin{center}\\rule{0.5\\linewidth}{0.5pt}\\end{center}\n\n\\subsubsection{\\texorpdfstring{\\textbf{Short Answer Questions\n(10)}}{Short Answer Questions (10)}}\\label{short-answer-questions-10}\n\n\\textbf{Q16:} Define \\textbf{OLTP} and provide an example of its use\ncase.\\\\\n\\emph{Answer:} OLTP (Online Transaction Processing) is used for\nreal-time transaction processing, such as managing e-commerce orders or\nbank transactions.\n\n\\textbf{Q17:} Explain the difference between \\textbf{ETL} and\n\\textbf{ELT}.\\\\\n\\emph{Answer:} ETL (Extract, Transform, Load) processes data by\ntransforming it before loading, while ELT (Extract, Load, Transform)\nloads data first and transforms it later.\n\n\\textbf{Q18:} What are the two main scalability strategies for\ndatabases, and how do they differ?\\\\\n\\emph{Answer:} Scale-up adds resources to a single server, while\nscale-out distributes workloads across multiple nodes, offering better\nhorizontal scalability.\n\n\\textbf{Q19:} Describe the role of a \\textbf{schema} in a relational\ndatabase.\\\\\n\\emph{Answer:} A schema defines the structure of data, including tables,\ncolumns, and relationships, ensuring consistency and organization.\n\n\\textbf{Q20:} Why is \\textbf{distributed SQL} considered a modern\nsolution for scalability?\\\\\n\\emph{Answer:} Distributed SQL combines the consistency of relational\ndatabases with the horizontal scalability of NoSQL, enabling large-scale\ndata management.\n\n\\textbf{Q21:} List three types of NoSQL databases and their use cases.\\\\\n\\emph{Answer:}\n\n\\begin{enumerate}\n\\def\\labelenumi{\\arabic{enumi}.}\n\\tightlist\n\\item\n  \\textbf{Document (MongoDB)}: Storing JSON-like data for flexible\n  schemas.\\\\\n\\item\n  \\textbf{Columnar (Cassandra)}: High write-throughput for time-series\n  data.\\\\\n\\item\n  \\textbf{Graph (Neo4j)}: Managing complex relationships in social\n  networks.\n\\end{enumerate}\n\n\\textbf{Q22:} What is the primary advantage of \\textbf{in-memory\ndatabases}?\\\\\n\\emph{Answer:} In-memory databases store data in RAM, enabling faster\naccess and processing compared to disk-based systems.\n\n\\textbf{Q23:} How does a \\textbf{time series database} differ from a\ntraditional relational database?\\\\\n\\emph{Answer:} Time series databases are optimized for storing and\nquerying time-stamped data, while relational databases focus on\nstructured, transactional data.\n\n\\textbf{Q24:} What is the main benefit of using \\textbf{DBaaS} (Database\nas a Service)?\\\\\n\\emph{Answer:} DBaaS reduces infrastructure management, offers\npay-as-you-go pricing, and provides scalability and global availability.\n\n\\textbf{Q25:} Explain why \\textbf{NoSQL databases} are often preferred\nfor big data applications.\\\\\n\\emph{Answer:} NoSQL databases offer flexible schemas, horizontal\nscalability, and high availability, making them ideal for handling\nunstructured or semi-structured big data.\n\n\\begin{center}\\rule{0.5\\linewidth}{0.5pt}\\end{center}\n\nLet me know if you need further clarification! 😊\n\n\\end{document}\n",
